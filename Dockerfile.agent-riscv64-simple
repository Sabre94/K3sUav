# Simple Dockerfile for UAV Agent RISC-V (using pre-built binary)
FROM riscv64/alpine:edge

# 安装 CA 证书（用于 HTTPS 请求）
RUN apk --no-cache add ca-certificates

# 创建非 root 用户
RUN addgroup -S uav && adduser -S uav -G uav

WORKDIR /app

# 复制已编译的 RISC-V 二进制文件
COPY bin/uav-agent-riscv64 /app/uav-agent

# 确保二进制文件可执行
RUN chmod +x /app/uav-agent

# 使用非 root 用户运行
USER uav

# 暴露端口（如果后续需要 metrics endpoint）
EXPOSE 8080

# 启动命令
ENTRYPOINT ["/app/uav-agent"]
